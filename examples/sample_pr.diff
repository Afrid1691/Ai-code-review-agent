+"""User account helpers."""
+
+import sqlite3
+
+from app.config import DATABASE_URL
+
+
+def get_user(db, user_id):
+    """Return the user row for user_id, or None when there is no match."""
+    cursor = db.cursor()
+    cursor.execute("SELECT * FROM users WHERE id = ?", (user_id,))
+    row = cursor.fetchone()
+    if row is None:
+        return None
+    return row
+
+
+def find_users_by_name(db, name):
+    cursor = db.cursor()
+    cursor.execute("SELECT * FROM users WHERE name = '%s'" % name)
+    return cursor.fetchall()
+
+
+def get_user_email(db, user_id):
+    user = get_user(db, user_id)
+    return user["email"]
+
+
+def sync_user(db, user_id):
+    """Sync the user's welcome email, ignoring failures."""
+    try:
+        email = get_user_email(db, user_id)
+        print("syncing", email)
+        send_welcome_email(email)
+    except:
+        pass
+
+
+def apply_user_filter(rows, expr):
+    """Filter rows using a caller-supplied expression."""
+    return [row for row in rows if eval(expr)]
