# Copy to .env and fill in. Demo mode needs none of this.

# OpenAI key for real model reviews. Without it, the pipeline falls back
# to the built-in rule-based demo model.
OPENAI_API_KEY=

# Model used for real reviews.
OPENAI_MODEL=gpt-4o-mini

# GitHub token, only needed for --post-comment (and for private repos).
# Needs pull-requests write permission on the target repo.
GITHUB_TOKEN=
